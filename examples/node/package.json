{
  "name": "react-router-effect-example-node",
  "private": true,
  "description": "A React Router framework-mode app served by react-router-effect on Effect's Node HTTP server.",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "NODE_ENV=development node server.js",
    "start": "NODE_ENV=production node server.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vp test run",
    "bench": "NODE_ENV=production vp test bench --run --reporter=verbose",
    "bench:http": "node bench/http.ts",
    "bench:body": "node bench/request-body.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@react-router/node": "8.4.0",
    "effect": "4.1.2",
    "isbot": "^5.1.40",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.4.0",
    "react-router-effect": "workspace:*"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@react-router/express": "8.5.1",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autocannon": "^8.0.0",
    "express": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
